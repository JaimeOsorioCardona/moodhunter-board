# ==============================================================================
# Mood Hunter Board - Environment Configuration Template
# ==============================================================================
# Copie este archivo como .env y complete sus valores:
#   cp .env.example .env

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (MySQL 8) ---
# Usado por docker-compose para inicializar el contenedor de MySQL:
MYSQL_ROOT_PASSWORD=moodhunter_root_secret
MYSQL_DATABASE=moodhunter_db
MYSQL_USER=moodhunter
MYSQL_PASSWORD=moodhunter_pass
MYSQL_PORT=3306

# URL asíncrona de conexión de SQLAlchemy para el backend:
# En Docker Compose el host es 'db':
DATABASE_URL=mysql+aiomysql://moodhunter:moodhunter_pass@db:3306/moodhunter_db
# Para desarrollo local fuera de Docker (MySQL local):
# DATABASE_URL=mysql+aiomysql://moodhunter:moodhunter_pass@localhost:3306/moodhunter_db
# Para pruebas rápidas sin MySQL (SQLite asíncrono):
# DATABASE_URL=sqlite+aiosqlite:///./moodhunter.db

# --- LLM Integration (Google Gemini) ---
# Si no se proporciona una API key, el sistema funcionará automáticamente
# en modo fallback determinista sin fallar la aplicación.
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=5.0
LLM_CIRCUIT_BREAKER_FAIL_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Frontend ---
# En producción/Docker Nginx enruta /api/v1 al backend.
# Para Vite dev server local se puede configurar la URL directa o proxy.
VITE_API_URL=/api/v1
